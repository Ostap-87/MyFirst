# AI Carousel Studio — локальная конфигурация.
# Скопируй в .env и заполни. Пустое значение = интеграция выключена,
# соответствующий роут вернёт 503 с подсказкой вместо падения.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# --- БД ---
DB_DRIVER=sqlite
# DB_FILE=./server/data/carousel-studio.db

# --- Холст (формат 3:4) ---
CANVAS_WIDTH=1080
CANVAS_HEIGHT=1440
SAFE_ZONE_TOP=120
SAFE_ZONE_RIGHT=80
SAFE_ZONE_BOTTOM=220
SAFE_ZONE_LEFT=80

# --- Шаг 5: генерация текста ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Шаг 3: шрифты ---
# Google Cloud API key с включённым Web Fonts Developer API
GOOGLE_FONTS_API_KEY=

# --- Шаг 6: визуал ---
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=

# --- Шаг 7: публикация в Meta ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/meta/oauth/callback
# Meta Graph API забирает картинки только по публичному HTTPS-URL.
# Для локальной публикации сюда идёт адрес туннеля (например ngrok).
PUBLIC_BASE_URL=
