node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# whisper.cpp и модели распознавания — качаются локально, в репозиторий не идут
whisper.cpp

# Локальные материалы (чужие или тяжёлые исходники) — в репозиторий не идут
public/local

# Звук, вынутый из съёмки под расшифровку, — производное от public/local,
# которой в репозитории тоже нет. Наши собственные звуки лежат в
# public/audio/sfx и этим правилом не задеваются: оно только на верхний уровень.
public/audio/*.wav
